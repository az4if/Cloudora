# Copy this file to ".env" and edit what you need. Every line is optional; delete or leave
# commented anything you don't want to change. Real environment variables win over this file.

# Port the server listens on
PORT=8080

# --- Real-browser fetching (needs: python3 and `pip install -r requirements.txt`) ---
# Set to 0 to turn off the server-side "real browser" HTTP transport (the browser then uses libcurl.js)
# CLOUDORA_IMPERSONATE=0
# Force one browser fingerprint for every request instead of matching the visitor's browser
# (chrome, firefox, safari, safari_ios, or a specific build such as chrome142)
# IMPERSONATE_PROFILE=chrome
# Python binary to run the fetchers with
# PYTHON=python3

# --- Server-side lookups (address-bar suggestions) ---
# 0 = never use curl_cffi, 1 = always use it first, unset = only when a site answers like a bot filter
# CURL_CFFI=0
# Browser fingerprint for those lookups
# CURL_IMPERSONATE=chrome
# User agent for those lookups (defaults to a current desktop Chrome)
# UPSTREAM_UA=

# --- Debugging / local testing ---
# Log every request that goes through the real-browser fetcher
# CLOUDORA_DEBUG=1
# Let the tunnel reach localhost and your LAN. LOCAL TESTING ONLY, never on a public server.
# CLOUDORA_ALLOW_LOCAL=1
