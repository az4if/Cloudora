{
  "name": "cloudora",
  "version": "0.6.2",
  "description": "Cloudora: a self-hosted browser-in-a-browser (Scramjet + Wisp + libcurl)",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "build": "echo \"No build step needed\"",
    "test": "node --test tests/engine.test.mjs tests/provider.test.mjs tests/upstream.test.mjs tests/impersonate.test.mjs",
    "build-filters": "node scripts/build-filters.mjs",
    "update-filters": "node scripts/build-filters.mjs --download"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@mercuryworkshop/bare-mux": "^2.1.9",
    "@mercuryworkshop/libcurl-transport": "^1.5.2",
    "@mercuryworkshop/scramjet": "https://github.com/MercuryWorkshop/scramjet/releases/download/v1.1.0/mercuryworkshop-scramjet-1.1.0.tgz",
    "@mercuryworkshop/wisp-js": "^0.4.1",
    "hls.js": "^1.5.0"
  }
}